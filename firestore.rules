rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user is the bootstrapped admin or owner
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'darkmisfit.ai@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Helper function to check if the user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isOwner(userId) || isAdmin();

      // User subcollections: clips, visionLogs, notes, vault, council
      match /clips/{clipId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /visionLogs/{logId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /notes/{noteId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /vault/{assetId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /council/{sessionId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Admin collection
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
